*** Add File: src/executor/pii-masker.ts
+const MASK_TOKEN = "[MASKED]";
+
+export type MaskingOptions = {
+  retainHash?: boolean;
+};
+
+const hashString = (value: string): string => {
+  let hash = 0;
+  for (let i = 0; i < value.length; i += 1) {
+    hash = (hash << 5) - hash + value.charCodeAt(i);
+    hash |= 0;
+  }
+  return `#${Math.abs(hash).toString(16)}`;
+};
+
+export const maskValue = (value: unknown, options: MaskingOptions = {}): string => {
+  if (typeof value !== "string") {
+    return MASK_TOKEN;
+  }
+  return options.retainHash ? `${MASK_TOKEN}:${hashString(value)}` : MASK_TOKEN;
+};
+
+export const maskPayload = (
+  payload: Record<string, unknown>,
+  keys: string[],
+  options: MaskingOptions = {}
+): Record<string, unknown> => {
+  return Object.entries(payload).reduce<Record<string, unknown>>((acc, [key, val]) => {
+    if (keys.includes(key)) {
+      acc[key] = maskValue(val, options);
+    } else if (typeof val === "object" && val !== null && !Array.isArray(val)) {
+      acc[key] = maskPayload(val as Record<string, unknown>, keys, options);
+    } else {
+      acc[key] = val;
+    }
+    return acc;
+  }, {});
+};
