[2m2025-10-13T13:14:00.623672Z[0m [32m INFO[0m ToolCall: shell {"command":["bash","-lc","cat <<'EOF' > scripts/live/notify-report.ts\n#!/usr/bin/env tsx\nimport path from \"node:path\";\nimport fsx from \"fs-extra\";\nimport { Command } from \"commander\";\nimport { LiveNotifier } from \"../../src/live/notifier\";\n\nconst program = new Command();\n\nprogram\n  .argument(\"<sessionId>\", \"Live session identifier\")\n  .option(\"--reports-dir <path>\", \"Report directory\", \"reports/live-sessions\")\n  .option(\"--webhook <url>\", \"Slack webhook override\");\n\nprogram.parse(process.argv);\n\nconst [sessionId] = program.args;\nconst options = program.opts<{ reportsDir: string; webhook?: string }>();\n\nasync function main() {\n  const reportsDir = path.resolve(options.reportsDir);\n  const file = path.join(reportsDir, `${sessionId}.json`);\n  if (!(await fsx.pathExists(file))) {\n    throw new Error(`Report not found at ${file}`);\n  }\n\n  const report = await fsx.readJson(file);\n  const webhook =\n    options.webhook ?? process.env.SLACK_LIVE_WEBHOOK_URL ?? process.env.SLACK_WEBHOOK_URL;\n  if (!webhook) {\n    console.warn(\"Slack webhook not configured; skipping notification.\");\n    return;\n  }\n\n  const notifier = new LiveNotifier({ webhookUrl: webhook });\n  await notifier.notify({\n    type: \"session-complete\",\n    sessionId,\n    title: `Live session ${sessionId} summary`,\n    message: \"Live session report is available.\",\n    severity: report.sla.breaches?.length ? \"warning\" : \"info\",\n    fields: {\n      approvals: Array.isArray(report.approvals) ? report.approvals.length : 0,\n      telemetryBundles: Array.isArray(report.telemetryBundles)\n        ? report.telemetryBundles.length\n        : 0,\n      slaBreaches: report.sla.breaches?.length ?? 0\n    }\n  });\n\n  console.log(`Notification sent for session ${sessionId}.`);\n}\n\nmain().catch((error) => {\n  console.error(error instanceof Error ? error.message : String(error));\n  process.exit(1);\n});\nEOF\n"],"timeout_ms":120000,"workdir":"."}
