-import type { FullConfig } from "@playwright/test";
-
-export default async function globalTeardown(_config: FullConfig): Promise<void> {
-  // Placeholder: Implemented in T017 to stop MCP and clean artifacts.
-}
+import type { FullConfig } from "@playwright/test";
+import path from "node:path";
+import fsx from "fs-extra";
+import { liveSessionManager } from "../../src/live/session-manager";
+
+const runtimeStatePath = path.resolve("var/live-sessions/runtime-state.json");
+
+export default async function globalTeardown(_config: FullConfig): Promise<void> {
+  if (!(await fsx.pathExists(runtimeStatePath))) {
+    return;
+  }
+
+  const state = (await fsx.readJson(runtimeStatePath)) as {
+    sessionId: string;
+    launcherPid: number;
+  };
+
+  if (state.launcherPid) {
+    try {
+      process.kill(state.launcherPid, "SIGTERM");
+    } catch (error) {
+      console.warn(`Failed to terminate MCP launcher pid=${state.launcherPid}:`, error);
+    }
+  }
+
+  const session = liveSessionManager.get(state.sessionId);
+  if (session && session.status !== "passed" && session.status !== "failed" && session.status !== "aborted") {
+    await liveSessionManager.update(state.sessionId, { status: "aborted" });
+  }
+
+  await fsx.remove(runtimeStatePath);
+}
