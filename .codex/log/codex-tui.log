*** Add File: src/orchestrator/graph.ts
+export type WorkflowState =
+  | "PLANNING"
+  | "AWAITING_PREAPPROVAL"
+  | "RUNNING"
+  | "AWAITING_RUNTIME_APPROVAL"
+  | "PAUSED"
+  | "RETRYING"
+  | "SUPERVISOR_PATCH"
+  | "COMPLETED"
+  | "ABORTED"
+  | "FAILED";
+
+export interface TransitionContext {
+  state: WorkflowState;
+  planId: string;
+  requestId?: string;
+  reason?: string;
+}
+
+export class OrchestratorGraph {
+  private current: WorkflowState = "PLANNING";
+
+  public getState(): WorkflowState {
+    return this.current;
+  }
+
+  public reset(): void {
+    this.current = "PLANNING";
+  }
+
+  public onPlanReady(): void {
+    this.ensureState(["PLANNING"]);
+    this.current = "AWAITING_PREAPPROVAL";
+  }
+
+  public onPreApprovalApproved(): void {
+    this.ensureState(["AWAITING_PREAPPROVAL"]);
+    this.current = "RUNNING";
+  }
+
+  public onPreApprovalRejected(): void {
+    this.ensureState(["AWAITING_PREAPPROVAL"]);
+    this.current = "PLANNING";
+  }
+
+  public requestRuntimeApproval(): void {
+    this.ensureState(["RUNNING"]);
+    this.current = "AWAITING_RUNTIME_APPROVAL";
+  }
+
+  public onRuntimeApproved(): void {
+    this.ensureState(["AWAITING_RUNTIME_APPROVAL"]);
+    this.current = "RUNNING";
+  }
+
+  public onRuntimeRejected(): void {
+    this.ensureState(["AWAITING_RUNTIME_APPROVAL"]);
+    this.current = "SUPERVISOR_PATCH";
+  }
+
+  public onSupervisorPatchApplied(): void {
+    this.ensureState(["SUPERVISOR_PATCH"]);
+    this.current = "RUNNING";
+  }
+
+  public onPause(): void {
+    this.ensureState(["RUNNING"]);
+    this.current = "PAUSED";
+  }
+
+  public onResume(): void {
+    this.ensureState(["PAUSED"]);
+    this.current = "RUNNING";
+  }
+
+  public onAbort(): void {
+    this.ensureState([
+      "RUNNING",
+      "PAUSED",
+      "AWAITING_RUNTIME_APPROVAL",
+      "SUPERVISOR_PATCH"
+    ]);
+    this.current = "ABORTED";
+  }
+
+  public onFailure(): void {
+    this.ensureState([
+      "RUNNING",
+      "AWAITING_RUNTIME_APPROVAL",
+      "SUPERVISOR_PATCH"
+    ]);
+    this.current = "FAILED";
+  }
+
+  public onComplete(): void {
+    this.ensureState(["RUNNING"]);
+    this.current = "COMPLETED";
+  }
+
+  private ensureState(expected: WorkflowState[]): void {
+    if (!expected.includes(this.current)) {
+      throw new Error(
+        `Invalid transition from ${this.current}. Expected one of ${expected.join(
+          ", "
+        )}`
+      );
+    }
+  }
+}
