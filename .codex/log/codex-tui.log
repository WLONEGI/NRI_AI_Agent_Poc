+import { liveSessionManager, type LiveSessionStatus } from "../../../src/live/session-manager";
+
+function requireSessionId(): string {
+  const sessionId = process.env.LIVE_SESSION_ID;
+  if (!sessionId) {
+    throw new Error("LIVE_SESSION_ID not set. Ensure global setup has started a live session.");
+  }
+  return sessionId;
+}
+
+export async function recordStepOutcome(
+  stepId: string,
+  outcome: "passed" | "failed",
+  metadata: Record<string, unknown> = {}
+): Promise<void> {
+  const sessionId = requireSessionId();
+  await liveSessionManager.update(sessionId, {
+    metadata: {
+      [`step:${stepId}`]: {
+        outcome,
+        at: new Date().toISOString(),
+        ...metadata
+      }
+    }
+  });
+}
+
+export async function completeLiveSession(status: "passed" | "failed", metadata?: Record<string, unknown>) {
+  const sessionId = requireSessionId();
+  await liveSessionManager.update(sessionId, {
+    status,
+    metadata
+  });
+}
+
+export async function setLiveSessionStatus(status: LiveSessionStatus) {
+  const sessionId = requireSessionId();
+  await liveSessionManager.update(sessionId, { status });
+}
+
+export function getLiveSessionId(): string {
+  return requireSessionId();
+}
