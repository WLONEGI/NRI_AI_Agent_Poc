+#!/usr/bin/env node
+/**
+ * Helper script executed within an Electron runtime to leverage safeStorage.
+ * STDOUT: base64 encoded encrypted payload
+ */
+const { app, safeStorage } = require('electron');
+
+function parseArgs() {
+  const args = process.argv.slice(2);
+  const parsed = {};
+  for (let i = 0; i < args.length; i += 2) {
+    const key = args[i];
+    const value = args[i + 1];
+    parsed[key] = value;
+  }
+  return parsed;
+}
+
+const args = parseArgs();
+
+if (!args['--value']) {
+  console.error('Missing --value argument');
+  process.exit(1);
+}
+
+async function main() {
+  await app.whenReady();
+
+  if (!safeStorage.isEncryptionAvailable()) {
+    console.error('Electron safeStorage encryption is not available on this system.');
+    app.exit(2);
+    return;
+  }
+
+  try {
+    const encrypted = safeStorage.encryptString(args['--value']).toString('base64');
+    process.stdout.write(encrypted);
+    app.exit(0);
+  } catch (error) {
+    console.error(error instanceof Error ? error.message : String(error));
+    app.exit(3);
+  }
+}
+
+main();
