+#!/usr/bin/env tsx
+import { Command } from 'commander';
+import { readFile, writeFile } from 'node:fs/promises';
+import { spawnSync } from 'node:child_process';
+import { createRequire } from 'node:module';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import fsx from 'fs-extra';
+
+const require = createRequire(import.meta.url);
+const electronBinary: string = require('electron');
+const helperScript = fileURLToPath(new URL('./helpers/encrypt-safe-storage.js', import.meta.url));
+
+const program = new Command();
+
+program
+  .requiredOption('--key <name>', 'Identifier to name the encrypted secret payload')
+  .option('--token <value>', 'Plain MCP authentication token')
+  .option('--token-file <path>', 'File containing the MCP authentication token')
+  .option('--cert-file <path>', 'PEM encoded client certificate to encrypt')
+  .option('--key-file <path>', 'PEM encoded client private key to encrypt')
+  .option('--out <dir>', 'Output directory for encrypted payload', 'config/live-mcp/secrets')
+  .option('--pretty', 'Pretty print JSON output', false);
+
+program.parse(process.argv);
+
+type Options = ReturnType<typeof program.opts>;
+
+const options: Options = program.opts();
+
+async function readPayload(label: string, directValue?: string, filePath?: string): Promise<string | undefined> {
+  if (directValue) {
+    return directValue;
+  }
+
+  if (!filePath) {
+    return undefined;
+  }
+
+  const resolved = path.resolve(filePath);
+  try {
+    return (await readFile(resolved, 'utf-8')).trim();
+  } catch (error) {
+    throw new Error(`Failed to read ${label} from ${resolved}: ${error instanceof Error ? error.message : String(error)}`);
+  }
+}
+
+function encryptWithSafeStorage(value: string): string {
+  const result = spawnSync(
+    electronBinary,
+    [helperScript, '--value', value],
+    {
+      encoding: 'utf-8',
+      env: {
+        ...process.env,
+        ELECTRON_ENABLE_LOGGING: '0',
+      },
+    },
+  );
+
+  if (result.status !== 0) {
+    const stderr = result.stderr?.toString()?.trim();
+    throw new Error(`Electron safeStorage encryption failed (exit ${result.status})${stderr ? `: ${stderr}` : ''}`);
+  }
+
+  return result.stdout.trim();
+}
+
+async function main() {
+  const token = await readPayload('token', options.token, options.tokenFile);
+  if (!token) {
+    throw new Error('Token not provided. Use --token or --token-file.');
+  }
+
+  const cert = await readPayload('certificate', undefined, options.certFile);
+  const key = await readPayload('private key', undefined, options.keyFile);
+
+  const encryptedToken = encryptWithSafeStorage(token);
+  const encryptedCert = cert ? encryptWithSafeStorage(cert) : undefined;
+  const encryptedKey = key ? encryptWithSafeStorage(key) : undefined;
+
+  const outputDir = path.resolve(options.out);
+  const outputFile = path.join(outputDir, `${options.key}.json`);
+
+  await fsx.ensureDir(outputDir);
+
+  const payload = {
+    key: options.key,
+    createdAt: new Date().toISOString(),
+    encryption: {
+      algorithm: 'electron-safe-storage-v1',
+      bundler: path.basename(helperScript),
+    },
+    payload: {
+      token: encryptedToken,
+      certificate: encryptedCert,
+      privateKey: encryptedKey,
+    },
+    meta: {
+      tokenSource: options.token ? 'inline' : options.tokenFile ? path.resolve(options.tokenFile) : null,
+      certificateSource: options.certFile ? path.resolve(options.certFile) : null,
+      privateKeySource: options.keyFile ? path.resolve(options.keyFile) : null,
+    },
+  };
+
+  await writeFile(outputFile, JSON.stringify(payload, null, options.pretty ? 2 : 0));
+  console.log(`Encrypted secrets saved to ${outputFile}`);
+}
+
+main().catch((error) => {
+  console.error(error instanceof Error ? error.message : String(error));
+  process.exit(1);
+});
