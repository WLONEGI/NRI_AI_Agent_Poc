+import type { FullConfig } from "@playwright/test";
+import { spawn } from "node:child_process";
+import readline from "node:readline";
+import path from "node:path";
+import fsx from "fs-extra";
+import { liveSessionManager } from "../../src/live/session-manager";
+
+const runtimeStatePath = path.resolve("var/live-sessions/runtime-state.json");
+
+interface RuntimeState {
+  sessionId: string;
+  launcherPid: number;
+  connectionInfo: unknown;
+}
+
+async function waitForLauncher(child: ReturnType<typeof spawn>): Promise<RuntimeState["connectionInfo"]> {
+  let resolved = false;
+  let connectionInfo: unknown = undefined;
+
+  const rl = readline.createInterface({ input: child.stdout! });
+
+  for await (const line of rl) {
+    const trimmed = line.toString().trim();
+    if (!connectionInfo) {
+      try {
+        connectionInfo = JSON.parse(trimmed);
+        continue;
+      } catch {
+        // Not JSON, keep scanning
+      }
+    }
+
+    if (trimmed.includes("MCP process ready")) {
+      resolved = true;
+      break;
+    }
+  }
+
+  if (!resolved) {
+    throw new Error("MCP launcher did not report readiness.");
+  }
+
+  return connectionInfo;
+}
+
+export default async function globalSetup(_config: FullConfig): Promise<void> {
+  await fsx.ensureDir(path.dirname(runtimeStatePath));
+
+  const session = await liveSessionManager.start({
+    planId: "plan-live-e2e",
+    approverIds: ["qa-operator"],
+    domains: ["mcp.local", "gate.local"]
+  });
+
+  process.env.LIVE_SESSION_ID = session.sessionId;
+
+  const launcher = spawn("yarn", ["live:launch-mcp", "--json"], {
+    stdio: ["ignore", "pipe", "pipe"],
+    env: {
+      ...process.env,
+      MCP_HOST: "127.0.0.1",
+      MCP_PORT: "4123"
+    }
+  });
+
+  launcher.stderr?.on("data", (data) => {
+    process.stderr.write(`[launch-mcp] ${data}`);
+  });
+
+  const connectionInfo = await waitForLauncher(launcher);
+
+  await fsx.writeJson(
+    runtimeStatePath,
+    {
+      sessionId: session.sessionId,
+      launcherPid: launcher.pid,
+      connectionInfo
+    } satisfies RuntimeState,
+    { spaces: 2 }
+  );
+
+  console.log(`Live session ${session.sessionId} initialized.`);
+}
