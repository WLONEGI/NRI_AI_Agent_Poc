+import { EventEmitter } from "node:events";
+import crypto from "node:crypto";
+
+export type LiveSessionStatus = "starting" | "running" | "passed" | "failed" | "aborted";
+
+export interface LiveSessionRecord {
+  sessionId: string;
+  planId: string;
+  startedAt: string;
+  endedAt?: string;
+  status: LiveSessionStatus;
+  approverIds: string[];
+  domains: string[];
+  slaReport?: Record<string, unknown>;
+  notificationStatus?: string | null;
+  metadata?: Record<string, unknown>;
+}
+
+export interface LiveSessionStartParams {
+  planId: string;
+  approverIds: string[];
+  domains: string[];
+  metadata?: Record<string, unknown>;
+}
+
+export interface LiveSessionUpdate {
+  status?: LiveSessionStatus;
+  endedAt?: string;
+  approverIds?: string[];
+  slaReport?: Record<string, unknown>;
+  notificationStatus?: string | null;
+  metadata?: Record<string, unknown>;
+}
+
+export interface LiveSessionPersistence {
+  insert(session: LiveSessionRecord): Promise<void> | void;
+  update(session: LiveSessionRecord): Promise<void> | void;
+}
+
+export type LiveSessionEvents = {
+  started: (session: LiveSessionRecord) => void;
+  updated: (session: LiveSessionRecord) => void;
+  completed: (session: LiveSessionRecord) => void;
+  failed: (session: LiveSessionRecord) => void;
+  aborted: (session: LiveSessionRecord) => void;
+};
+
+type EventKeys = keyof LiveSessionEvents;
+
+export class LiveSessionManager extends EventEmitter {
+  private sessions = new Map<string, LiveSessionRecord>();
+  private persistence?: LiveSessionPersistence;
+
+  constructor(persistence?: LiveSessionPersistence) {
+    super();
+    this.persistence = persistence;
+  }
+
+  public async start(params: LiveSessionStartParams): Promise<LiveSessionRecord> {
+    const session: LiveSessionRecord = {
+      sessionId: this.generateSessionId(),
+      planId: params.planId,
+      startedAt: new Date().toISOString(),
+      status: "starting",
+      approverIds: params.approverIds,
+      domains: params.domains,
+      metadata: params.metadata ?? {},
+    };
+
+    this.sessions.set(session.sessionId, session);
+    await this.persistence?.insert(session);
+    this.emitEvent("started", session);
+
+    // Transition to running immediately after start
+    return this.update(session.sessionId, { status: "running" });
+  }
+
+  public get(sessionId: string): LiveSessionRecord | undefined {
+    return this.sessions.get(sessionId);
+  }
+
+  public listActive(): LiveSessionRecord[] {
+    return Array.from(this.sessions.values()).filter(
+      (session) => session.status === "starting" || session.status === "running",
+    );
+  }
+
+  public async update(sessionId: string, patch: LiveSessionUpdate): Promise<LiveSessionRecord> {
+    const current = this.sessions.get(sessionId);
+    if (!current) {
+      throw new Error(`Live session ${sessionId} not found`);
+    }
+
+    const updated: LiveSessionRecord = {
+      ...current,
+      ...patch,
+      approverIds: patch.approverIds ?? current.approverIds,
+      slaReport: patch.slaReport ?? current.slaReport,
+      notificationStatus: patch.notificationStatus ?? current.notificationStatus,
+      metadata: {
+        ...(current.metadata ?? {}),
+        ...(patch.metadata ?? {}),
+      },
+    };
+
+    if (patch.status && this.isTerminal(patch.status)) {
+      updated.endedAt = patch.endedAt ?? new Date().toISOString();
+    }
+
+    this.sessions.set(sessionId, updated);
+    await this.persistence?.update(updated);
+    this.emitEvent("updated", updated);
+
+    if (patch.status && this.isTerminal(patch.status)) {
+      this.emitEvent(patch.status, updated);
+    }
+
+    return updated;
+  }
+
+  private isTerminal(status: LiveSessionStatus): status is "passed" | "failed" | "aborted" {
+    return status === "passed" || status === "failed" || status === "aborted";
+  }
+
+  private emitEvent<T extends EventKeys>(event: T, payload: Parameters<LiveSessionEvents[T]>[0]) {
+    this.emit(event, payload);
+  }
+
+  private generateSessionId(): string {
+    return `live-${crypto.randomUUID()}`;
+  }
+
+  public attachPersistence(persistence: LiveSessionPersistence) {
+    this.persistence = persistence;
+  }
+}
+
+export const liveSessionManager = new LiveSessionManager();
