+export type RuntimeTrigger =
+  | "external_submit"
+  | "upload"
+  | "download"
+  | "external_domain"
+  | "bulk_input"
+  | "dangerous_eval";
+
+export interface RuntimeApprovalPayload {
+  requestId: string;
+  planId: string;
+  trigger: RuntimeTrigger;
+  action: string;
+  target: Record<string, unknown>;
+  explainability: Record<string, unknown>;
+  pendingSince: string;
+}
+
+export interface RuntimeGateDecision {
+  approved: boolean;
+  decidedBy: string;
+  rationale?: string;
+  latencyMs?: number;
+}
+
+export class RuntimeGate {
+  public detectTriggers(step: {
+    action: string;
+    metadata?: Record<string, unknown>;
+  }): RuntimeTrigger | undefined {
+    const metadata = step.metadata ?? {};
+    if (metadata["external_submit"]) return "external_submit";
+    if (metadata["upload"]) return "upload";
+    if (metadata["download"]) return "download";
+    if (metadata["dangerous_eval"]) return "dangerous_eval";
+    if (metadata["bulk_input"]) return "bulk_input";
+    if (metadata["external_domain"]) return "external_domain";
+    return undefined;
+  }
+
+  public buildPayload(
+    requestId: string,
+    planId: string,
+    trigger: RuntimeTrigger,
+    step: Record<string, unknown>,
+    explainability: Record<string, unknown>
+  ): RuntimeApprovalPayload {
+    return {
+      requestId,
+      planId,
+      trigger,
+      action: String(step["action"] ?? "unknown"),
+      target: (step["target"] as Record<string, unknown>) ?? {},
+      explainability,
+      pendingSince: new Date().toISOString()
+    };
+  }
+
+  public requiresApproval(trigger?: RuntimeTrigger): boolean {
+    return Boolean(trigger);
+  }
+}
