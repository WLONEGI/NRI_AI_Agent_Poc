[2m2025-10-13T12:59:39.072976Z[0m [32m INFO[0m ToolCall: shell {"command":["bash","-lc","cat <<'EOF' > src/cli/replay-plan.ts\n#!/usr/bin/env tsx\nimport { Command } from \"commander\";\nimport path from \"node:path\";\nimport fsx from \"fs-extra\";\nimport { StateStore } from \"../state-store\";\nimport { ReplayPlanRepository } from \"../state-store/replay-plan-repository\";\n\nconst program = new Command();\n\nprogram\n  .argument(\"<sessionId>\", \"Live session identifier\")\n  .option(\"--output <path>\", \"Write replay plan JSON to file\")\n  .option(\"--pretty\", \"Pretty print JSON output\", false);\n\nprogram.parse(process.argv);\n\nconst [sessionId] = program.args;\nconst options = program.opts<{ output?: string; pretty?: boolean }>();\n\nasync function main() {\n  const store = StateStore.getInstance();\n  const session = store.getLiveSession(sessionId);\n  if (!session) {\n    throw new Error(`Live session ${sessionId} not found`);\n  }\n\n  const repository = new ReplayPlanRepository();\n  const snapshots = await repository.list(sessionId);\n  const approvals = store.listLiveApprovals(sessionId);\n\n  const plan = {\n    session,\n    approvals,\n    steps: snapshots.sort((a, b) => a.stepId.localeCompare(b.stepId))\n  };\n\n  const json = JSON.stringify(plan, null, options.pretty ? 2 : 0);\n\n  if (options.output) {\n    const outputPath = path.resolve(options.output);\n    await fsx.ensureDir(path.dirname(outputPath));\n    await fsx.writeFile(outputPath, json, { encoding: \"utf8\" });\n    console.log(`Replay plan written to ${outputPath}`);\n  } else {\n    console.log(json);\n  }\n}\n\nmain().catch((error) => {\n  console.error(error instanceof Error ? error.message : String(error));\n  process.exit(1);\n});\nEOF\n"],"workdir":".","timeout_ms":120000}
