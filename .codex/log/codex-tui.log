+#!/usr/bin/env tsx
+import { Command } from "commander";
+import { readFile } from "node:fs/promises";
+import process from "node:process";
+import { LiveNotifier } from "../../src/live/notifier";
+
+interface Metric {
+  name: string;
+  valueMs: number;
+  thresholdMs: number;
+  description?: string;
+  severity?: "info" | "warning" | "critical";
+}
+
+interface SlaReport {
+  sessionId: string;
+  metrics: Metric[];
+}
+
+const program = new Command();
+
+program
+  .requiredOption("--session <id>", "Live session identifier")
+  .option("--input <path>", "Path to SLA metrics JSON file")
+  .option("--webhook <url>", "Slack webhook URL override")
+  .option("--print-only", "Skip Slack notification and print summary", false);
+
+program.parse(process.argv);
+
+const options = program.opts<{
+  session: string;
+  input?: string;
+  webhook?: string;
+  printOnly?: boolean;
+}>();
+
+async function readInput(): Promise<SlaReport> {
+  if (options.input) {
+    const raw = await readFile(options.input, "utf-8");
+    return JSON.parse(raw) as SlaReport;
+  }
+
+  const chunks: Uint8Array[] = [];
+  for await (const chunk of process.stdin) {
+    chunks.push(chunk as Uint8Array);
+  }
+  const buffer = Buffer.concat(chunks);
+  return JSON.parse(buffer.toString("utf-8")) as SlaReport;
+}
+
+function evaluateMetrics(report: SlaReport) {
+  const breaches = report.metrics.filter((metric) => metric.valueMs > metric.thresholdMs);
+  return { breaches, total: report.metrics.length };
+}
+
+async function notify(breaches: Metric[], sessionId: string, webhookUrl: string) {
+  if (breaches.length === 0) return;
+
+  const notifier = new LiveNotifier({
+    webhookUrl,
+    maxRetries: 3,
+    baseDelayMs: 1000
+  });
+
+  const summary = breaches
+    .map(
+      (metric) =>
+        `${metric.name}: ${metric.valueMs}ms > ${metric.thresholdMs}ms${metric.description ? ` (${metric.description})` : ""}`
+    )
+    .join("\n");
+
+  await notifier.notify({
+    type: "sla-breach",
+    sessionId,
+    title: "Live session SLA breach detected",
+    message: summary,
+    severity: breaches.some((metric) => metric.severity === "critical") ? "critical" : "warning",
+    fields: Object.fromEntries(
+      breaches.map((metric) => [
+        metric.name,
+        `${metric.valueMs}ms (threshold ${metric.thresholdMs}ms)`
+      ])
+    )
+  });
+}
+
+async function main() {
+  const report = await readInput();
+  if (report.sessionId !== options.session) {
+    throw new Error(`Session mismatch: report=${report.sessionId} option=${options.session}`);
+  }
+
+  const { breaches, total } = evaluateMetrics(report);
+  console.log(
+    `Evaluated ${total} SLA metrics for session ${report.sessionId}. Breaches: ${breaches.length}`
+  );
+
+  for (const metric of breaches) {
+    console.log(` - ${metric.name}: ${metric.valueMs}ms > ${metric.thresholdMs}ms`);
+  }
+
+  if (!options.printOnly) {
+    const webhookUrl =
+      options.webhook ?? process.env.SLACK_LIVE_WEBHOOK_URL ?? process.env.SLACK_WEBHOOK_URL;
+    if (!webhookUrl) {
+      console.warn("Slack webhook URL not provided; skipping notification.");
+      return;
+    }
+    await notify(breaches, report.sessionId, webhookUrl);
+  }
+}
+
+main().catch((error) => {
+  console.error(error instanceof Error ? error.message : String(error));
+  process.exit(1);
+});
