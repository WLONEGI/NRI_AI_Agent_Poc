+import type { SpanPayload } from "./otlp-file-exporter";
+
+export type SpanContext = {
+  sessionId: string;
+  planId: string;
+  stepId?: string;
+};
+
+export const createPreApprovalSpan = (
+  context: SpanContext,
+  latencyMs: number
+): SpanPayload => ({
+  traceId: `${context.sessionId}-${context.planId}-pre`,
+  spanId: `${context.planId}-pre-span`,
+  name: "approval.pre",
+  startTime: new Date().toISOString(),
+  durationMs: latencyMs,
+  attributes: {
+    sessionId: context.sessionId,
+    planId: context.planId,
+    stepId: context.stepId ?? null,
+    category: "pre_approval"
+  }
+});
+
+export const createRuntimeApprovalSpan = (
+  context: SpanContext & { trigger: string },
+  latencyMs: number
+): SpanPayload => ({
+  traceId: `${context.sessionId}-${context.planId}-${context.trigger}`,
+  spanId: `${context.planId}-${context.trigger}-${Date.now()}`,
+  name: "approval.runtime",
+  startTime: new Date().toISOString(),
+  durationMs: latencyMs,
+  attributes: {
+    sessionId: context.sessionId,
+    planId: context.planId,
+    stepId: context.stepId ?? null,
+    trigger: context.trigger,
+    category: "runtime_approval"
+  }
