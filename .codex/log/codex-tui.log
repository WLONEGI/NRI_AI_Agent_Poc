+#!/usr/bin/env tsx
+import { Command } from 'commander';
+import { spawn } from 'node:child_process';
+import { createRequire } from 'node:module';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+import fsx from 'fs-extra';
+import crypto from 'node:crypto';
+import os from 'node:os';
+import { readFile } from 'node:fs/promises';
+import { setTimeout as delay } from 'node:timers/promises';
+
+type LaunchConfig = {
+  host: string;
+  allowed_domains: string[];
+  session: {
+    browser: 'chromium' | 'firefox' | 'webkit';
+    launchOptions?: Record<string, unknown>;
+  };
+  timeouts: {
+    connectMs: number;
+    approveMs: number;
+    resumeMs: number;
+  };
+  launcher?: {
+    command?: string;
+    args?: string[];
+    cwd?: string;
+    readyPattern?: string;
+    startTimeoutMs?: number;
+  };
+  secrets?: {
+    directory?: string;
+    tokenKey?: string;
+    certificateKey?: string;
+    privateKeyKey?: string;
+  };
+};
+
+type EncryptedSecret = {
+  key: string;
+  createdAt: string;
+  encryption: { algorithm: string };
+  payload: {
+    token?: string | null;
+    certificate?: string | null;
+    privateKey?: string | null;
+  };
+};
+
+const program = new Command();
+
+program
+  .option('--config <path>', 'Path to live MCP config', 'config/live-mcp/default.config.json')
+  .option('--secrets <dir>', 'Override directory for encrypted secrets')
+  .option('--json', 'Print resolved connection details as JSON', false)
+  .option('--no-spawn', 'Skip launching the MCP process (validation only)')
+  .option('--spawn-wait <ms>', 'Override start timeout in milliseconds')
+  .option('--silent', 'Suppress stdout/stderr from spawned process', false);
+
+program.parse(process.argv);
+
+const opts = program.opts<{
+  config: string;
+  secrets?: string;
+  json?: boolean;
+  spawn?: boolean;
+  spawnWait?: string;
+  silent?: boolean;
+}>();
+
+const require = createRequire(import.meta.url);
+const electronBinary: string = require('electron');
+const encryptHelper = fileURLToPath(new URL('./helpers/encrypt-safe-storage.js', import.meta.url));
+const decryptHelper = fileURLToPath(new URL('./helpers/decrypt-safe-storage.js', import.meta.url));
+
+function decryptWithSafeStorage(value?: string | null): string | undefined {
+  if (!value) return undefined;
+  const result = spawn(
+    electronBinary,
+    [decryptHelper, '--value', value],
+    {
+      stdio: ['ignore', 'pipe', 'pipe'],
+      env: {
+        ...process.env,
+        ELECTRON_ENABLE_LOGGING: '0',
+      },
+    },
+  );
+
+  let stdout = '';
+  let stderr = '';
+
+  result.stdout?.on('data', (buffer: Buffer) => {
+    stdout += buffer.toString();
+  });
+  result.stderr?.on('data', (buffer: Buffer) => {
+    stderr += buffer.toString();
+  });
+
+  return new Promise<string>((resolve, reject) => {
+    result.on('close', (code) => {
+      if (code !== 0) {
+        reject(new Error(`Failed to decrypt secret (exit ${code}): ${stderr.trim()}`));
+        return;
+      }
+      resolve(stdout.trim());
+    });
+  }) as unknown as string;
+}
+
+async function readEncryptedSecret(filePath: string): Promise<EncryptedSecret> {
+  const raw = await readFile(filePath, 'utf-8');
+  return JSON.parse(raw) as EncryptedSecret;
+}
+
+async function resolveSecrets(config: LaunchConfig) {
+  const directory = path.resolve(opts.secrets ?? config.secrets?.directory ?? 'config/live-mcp/secrets');
+  const secrets = {
+    token: undefined as string | undefined,
+    certificatePath: undefined as string | undefined,
+    privateKeyPath: undefined as string | undefined,
+  };
+
+  async function materializeFile(baseName: string, contents: string) {
+    const dir = path.resolve('var/live-sessions/credentials');
+    await fsx.ensureDir(dir);
+    const file = path.join(dir, `${baseName}.pem`);
+    await fsx.writeFile(file, contents, { mode: 0o600 });
+    return file;
+  }
+
+  if (config.secrets?.tokenKey) {
+    const tokenFile = path.join(directory, `${config.secrets.tokenKey}.json`);
+    if (await fsx.pathExists(tokenFile)) {
+      const encrypted = await readEncryptedSecret(tokenFile);
+      const decrypted = await decryptWithSafeStorage(encrypted.payload.token ?? undefined);
+      secrets.token = decrypted;
+    } else {
+      throw new Error(`Encrypted token file not found: ${tokenFile}`);
+    }
+  }
+
+  if (config.secrets?.certificateKey) {
+    const certFile = path.join(directory, `${config.secrets.certificateKey}.json`);
+    if (await fsx.pathExists(certFile)) {
+      const encrypted = await readEncryptedSecret(certFile);
+      const decrypted = await decryptWithSafeStorage(encrypted.payload.certificate ?? undefined);
+      if (decrypted) {
+        secrets.certificatePath = await materializeFile(config.secrets.certificateKey, decrypted);
+      }
+    }
+  }
+
+  if (config.secrets?.privateKeyKey) {
+    const keyFile = path.join(directory, `${config.secrets.privateKeyKey}.json`);
+    if (await fsx.pathExists(keyFile)) {
+      const encrypted = await readEncryptedSecret(keyFile);
+      const decrypted = await decryptWithSafeStorage(encrypted.payload.privateKey ?? undefined);
+      if (decrypted) {
+        secrets.privateKeyPath = await materializeFile(config.secrets.privateKeyKey, decrypted);
+      }
+    }
+  }
+
+  return secrets;
+}
+
+async function waitForReady(opts: {
+  child: ReturnType<typeof spawn>;
+  readyPattern?: string;
+  timeoutMs: number;
+}) {
+  if (!opts.readyPattern) {
+    return;
+  }
+  const regex = new RegExp(opts.readyPattern);
+
+  return new Promise<void>((resolve, reject) => {
+    const timer = setTimeout(() => {
+      opts.child.kill();
+      reject(new Error(`Timed out waiting for MCP ready pattern (${opts.timeoutMs}ms)`));
+    }, opts.timeoutMs);
+
+    const scan = (data: Buffer) => {
+      const text = data.toString();
+      if (regex.test(text)) {
+        clearTimeout(timer);
+        resolve();
+      }
+    };
+
+    opts.child.stdout?.on('data', scan);
+    opts.child.stderr?.on('data', scan);
+    opts.child.on('exit', (code) => {
+      clearTimeout(timer);
+      reject(new Error(`MCP process exited before ready signal (code ${code ?? 'unknown'})`));
+    });
+  });
+}
+
+async function main() {
+  const configPath = path.resolve(opts.config);
+  if (!(await fsx.pathExists(configPath))) {
+    throw new Error(`Config file not found at ${configPath}`);
+  }
+
+  const config = JSON.parse(await readFile(configPath, 'utf-8')) as LaunchConfig;
+  const secrets = await resolveSecrets(config);
+
+  const connectionInfo = {
+    host: config.host,
+    allowedDomains: config.allowed_domains,
+    session: config.session,
+    timeouts: config.timeouts,
+    tokenProvided: Boolean(secrets.token),
+    certificatePath: secrets.certificatePath,
+    privateKeyPath: secrets.privateKeyPath,
+  };
+
+  if (opts.json) {
+    console.log(JSON.stringify(connectionInfo, null, 2));
+  }
+
+  if (opts.spawn === false || !config.launcher?.command) {
+    return;
+  }
+
+  const spawnEnv = {
+    ...process.env,
+    MCP_BROWSER_HOST: config.host,
+    MCP_BROWSER_ALLOWED_DOMAINS: config.allowed_domains.join(','),
+    MCP_BROWSER_TOKEN: secrets.token ?? '',
+    MCP_BROWSER_CERT_PATH: secrets.certificatePath ?? '',
+    MCP_BROWSER_KEY_PATH: secrets.privateKeyPath ?? '',
+    MCP_SESSION_ID: crypto.randomUUID(),
+  };
+
+  const child = spawn(
+    config.launcher.command,
+    config.launcher.args ?? [],
+    {
+      cwd: config.launcher.cwd ? path.resolve(config.launcher.cwd) : process.cwd(),
+      env: spawnEnv,
+    },
+  );
+
+  if (!opts.silent) {
+    child.stdout?.on('data', (data) => process.stdout.write(`[mcp] ${data}`));
+    child.stderr?.on('data', (data) => process.stderr.write(`[mcp] ${data}`));
+  }
+
+  const timeoutMs = opts.spawnWait
+    ? Number(opts.spawnWait)
+    : config.launcher.startTimeoutMs ?? 15000;
+
+  await waitForReady({
+    child,
+    readyPattern: config.launcher.readyPattern,
+    timeoutMs,
+  });
+
+  console.log('MCP process ready.');
+
+  const exitPromise = new Promise<number>((resolve) => {
+    child.on('exit', (code) => {
+      resolve(code ?? 0);
+    });
+  });
+
+  const signals: NodeJS.Signals[] = ['SIGINT', 'SIGTERM'];
+  signals.forEach((signal) => {
+    process.on(signal, () => {
+      child.kill(signal);
+    });
+  });
+
+  const code = await exitPromise;
+  if (code !== 0) {
+    throw new Error(`MCP process exited with code ${code}`);
+  }
+}
+
+main().catch((error) => {
+  console.error(error instanceof Error ? error.message : String(error));
+  process.exit(1);
+});
