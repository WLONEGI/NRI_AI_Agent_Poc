+#!/usr/bin/env tsx
+import path from 'node:path';
+import fsx from 'fs-extra';
+
+const paths = [
+  'var/live-sessions',
+  'var/live-sessions/checkpoints',
+  'var/live-sessions/telemetry',
+  'var/live-sessions/screenshots',
+  'var/live-sessions/network',
+  'reports/live-sessions',
+];
+
+async function main() {
+  for (const relative of paths) {
+    const absolute = path.resolve(relative);
+    await fsx.ensureDir(absolute);
+  }
+
+  const readmePath = path.resolve('reports/live-sessions/README.md');
+  if (!(await fsx.pathExists(readmePath))) {
+    await fsx.writeFile(
+      readmePath,
+      [
+        '# Live Session Reports',
+        '',
+        'This directory stores generated live session summaries (`yarn report:live-session`).',
+        'Artifacts are retained for 90 days unless purged by `scripts/maintenance/purge-live-artifacts.ts`.',
+      ].join('\n'),
+    );
+  }
+
+  console.log('Live storage directories bootstrapped.');
+}
+
+main().catch((error) => {
+  console.error(error instanceof Error ? error.message : String(error));
+  process.exit(1);
+});
