[2m2025-10-13T13:14:23.506125Z[0m [32m INFO[0m ToolCall: shell {"command":["bash","-lc","cat <<'EOF' > scripts/maintenance/purge-live-artifacts.ts\n#!/usr/bin/env tsx\nimport path from \"node:path\";\nimport fsx from \"fs-extra\";\nimport { Command } from \"commander\";\n\nconst program = new Command();\n\nprogram\n  .option(\"--base-dir <path>\", \"Base directory for live artifacts\", \"var/live-sessions\")\n  .option(\"--max-age <hours>\", \"Retention window in hours\", \"2160\"); // 90 days\n\nprogram.parse(process.argv);\n\nconst options = program.opts<{ baseDir: string; maxAge: string }>();\nconst thresholdMs = Number(options.maxAge) * 60 * 60 * 1000;\n\nasync function removeIfOld(filePath: string) {\n  const stats = await fsx.stat(filePath);\n  const ageMs = Date.now() - stats.mtime.getTime();\n  if (ageMs > thresholdMs) {\n    await fsx.remove(filePath);\n    return true;\n  }\n  return false;\n}\n\nasync function purgeDirectory(directory: string) {\n  if (!(await fsx.pathExists(directory))) return 0;\n  const items = await fsx.readdir(directory);\n  let removed = 0;\n  for (const item of items) {\n    const full = path.join(directory, item);\n    const stats = await fsx.stat(full);\n    if (stats.isDirectory()) {\n      removed += await purgeDirectory(full);\n      const contents = await fsx.readdir(full).catch(() => []);\n      if (contents.length === 0) {\n        await fsx.remove(full);\n      }\n      continue;\n    }\n    if (await removeIfOld(full)) {\n      removed += 1;\n    }\n  }\n  return removed;\n}\n\nasync function main() {\n  const baseDir = path.resolve(options.baseDir);\n  const removed = await purgeDirectory(baseDir);\n  console.log(`Removed ${removed} expired artifacts from ${baseDir}`);\n}\n\nmain().catch((error) => {\n  console.error(error instanceof Error ? error.message : String(error));\n  process.exit(1);\n});\nEOF\n"],"timeout_ms":120000,"workdir":"."}
