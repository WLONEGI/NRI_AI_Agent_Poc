+import { StateStore } from "@state-store/index";
+import type { PlanSummary } from "@gate-ui/types";
+
+const store = StateStore.getInstance();
+
+export const getPlanSummary = (planId: string): PlanSummary => {
+  const plan = store.getPlan(planId);
+  if (!plan) {
+    throw new Error(`Plan ${planId} not found`);
+  }
+  return {
+    planId: plan.planId,
+    sessionId: plan.sessionId,
+    summary: plan.summary,
+    steps: (plan.steps as PlanSummary["steps"]) ?? [],
+    capabilities: (plan.capabilities as Record<string, string[]>) ?? {},
+    policy: (plan.policy as { requires: string[] }) ?? { requires: [] },
+    explainability:
+      (plan.explainabilityDigest as PlanSummary["explainability"]) ?? [],
+    externalTargets:
+      plan.policy && typeof plan.policy === "object"
+        ? (plan.policy as { externalTargets?: string[] }).externalTargets
+        : []
+  };
+};
+
+export const savePreApprovalDecision = (input: {
+  planId: string;
+  approved: boolean;
+  decidedBy: string;
+  rationale?: string;
+  latencyMs?: number;
+}): void => {
+  store.saveApprovalDecision({
+    requestId: `${input.planId}-pre`,
+    planId: input.planId,
+    type: "pre",
+    payload: {},
+    status: input.approved ? "approved" : "rejected",
+    decidedAt: new Date().toISOString(),
+    decidedBy: input.decidedBy,
+    rationale: input.rationale ?? null,
+    trigger: null
+  });
+};
