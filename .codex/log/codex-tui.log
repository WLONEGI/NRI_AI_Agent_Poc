[2m2025-10-13T12:59:10.399270Z[0m [32m INFO[0m ToolCall: shell {"command":["bash","-lc","cat <<'EOF' > src/state-store/replay-plan-repository.ts\nimport path from \"node:path\";\nimport fsx from \"fs-extra\";\n\nexport interface ReplaySnapshot {\n  sessionId: string;\n  stepId: string;\n  checkpointId: string;\n  planSummary: string;\n  approvedScopes: string[];\n  approverId?: string;\n  decision?: \"approved\" | \"rejected\";\n  rationale?: string;\n  createdAt?: string;\n}\n\nexport class ReplayPlanRepository {\n  private readonly baseDir: string;\n\n  constructor(baseDir = \"var/live-sessions/replay\") {\n    this.baseDir = path.resolve(baseDir);\n  }\n\n  public async save(snapshot: ReplaySnapshot): Promise<void> {\n    const dir = path.join(this.baseDir, snapshot.sessionId);\n    await fsx.ensureDir(dir);\n    const file = path.join(dir, `${snapshot.stepId}.json`);\n    await fsx.writeJson(\n      file,\n      {\n        ...snapshot,\n        createdAt: snapshot.createdAt ?? new Date().toISOString()\n      },\n      { spaces: 2 }\n    );\n  }\n\n  public async list(sessionId: string): Promise<ReplaySnapshot[]> {\n    const dir = path.join(this.baseDir, sessionId);\n    if (!(await fsx.pathExists(dir))) {\n      return [];\n    }\n    const files = await fsx.readdir(dir);\n    const snapshots: ReplaySnapshot[] = [];\n    for (const file of files.sort()) {\n      const full = path.join(dir, file);\n      const data = await fsx.readJson(full);\n      snapshots.push(data as ReplaySnapshot);\n    }\n    return snapshots;\n  }\n}\nEOF\n"],"workdir":".","timeout_ms":120000}
