[2m2025-10-13T13:13:16.229958Z[0m [32m INFO[0m ToolCall: shell {"command":["bash","-lc","cat <<'EOF' > src/live/sla-summary.ts\nexport interface SlaMetric {\n  name: string;\n  valueMs: number;\n  thresholdMs: number;\n  description?: string;\n  severity?: \"info\" | \"warning\" | \"critical\";\n}\n\nexport interface SlaSummary {\n  sessionId: string;\n  metrics: SlaMetric[];\n  breaches: SlaMetric[];\n}\n\nexport interface SlaInput {\n  sessionId: string;\n  gateLatencySamples?: number[];\n  pauseResumeSamples?: number[];\n  timeoutMs?: number;\n}\n\nconst DEFAULT_THRESHOLDS = {\n  gateLatencyMs: 200,\n  pauseResumeMs: 200\n};\n\nexport function summarizeSla(input: SlaInput): SlaSummary {\n  const metrics: SlaMetric[] = [];\n\n  if (input.gateLatencySamples?.length) {\n    const avg = average(input.gateLatencySamples);\n    metrics.push({\n      name: \"gateLatencyMs\",\n      valueMs: avg,\n      thresholdMs: DEFAULT_THRESHOLDS.gateLatencyMs,\n      description: `Average of ${input.gateLatencySamples.length} samples`\n    });\n  }\n\n  if (input.pauseResumeSamples?.length) {\n    const avg = average(input.pauseResumeSamples);\n    metrics.push({\n      name: \"pauseResumeMs\",\n      valueMs: avg,\n      thresholdMs: DEFAULT_THRESHOLDS.pauseResumeMs,\n      description: `Average of ${input.pauseResumeSamples.length} samples`\n    });\n  }\n\n  const breaches = metrics.filter((metric) => metric.valueMs > metric.thresholdMs);\n\n  return {\n    sessionId: input.sessionId,\n    metrics,\n    breaches\n  };\n}\n\nfunction average(values: number[]): number {\n  const sum = values.reduce((acc, value) => acc + value, 0);\n  return Math.round(sum / values.length);\n}\nEOF\n"]}
[2m2025-10-13T13:13:34.143191Z[0m [32m INFO[0m ToolCall: shell {"command":["bash","-lc","cat <<'EOF' > src/live/report-generator.ts\nimport path from \"node:path\";\nimport fsx from \"fs-extra\";\nimport { StateStore } from \"@state-store/index\";\nimport { ReplayPlanRepository } from \"@state-store/replay-plan-repository\";\nimport { summarizeSla } from \"./sla-summary\";\n\nexport interface GenerateReportOptions {\n  baseDir?: string;\n  reportsDir?: string;\n  store?: StateStore;\n  writeToFile?: boolean;\n}\n\nexport interface LiveSessionReport {\n  session: ReturnType<StateStore[\"getLiveSession\"]>;\n  approvals: ReturnType<StateStore[\"listLiveApprovals\"]>;\n  telemetryBundles: Array<{ file: string; generatedAt: string }>;\n  sla: ReturnType<typeof summarizeSla>;\n  replayPlan: Awaited<ReturnType<ReplayPlanRepository[\"list\"]>>;\n}\n\nexport async function generateLiveSessionReport(\n  sessionId: string,\n  options: GenerateReportOptions = {}\n): Promise<LiveSessionReport> {\n  const baseDir = path.resolve(options.baseDir ?? \"var/live-sessions\");\n  const reportsDir = path.resolve(options.reportsDir ?? \"reports/live-sessions\");\n  const store = options.store ?? StateStore.getInstance();\n  const repository = new ReplayPlanRepository(path.join(baseDir, \"replay\"));\n\n  const session = store.getLiveSession(sessionId);\n  if (!session) {\n    throw new Error(`Live session ${sessionId} not found`);\n  }\n\n  const approvals = store.listLiveApprovals(sessionId);\n  const telemetryDir = path.join(baseDir, \"telemetry\", sessionId);\n  const telemetryBundles: Array<{ file: string; generatedAt: string }> = [];\n\n  if (await fsx.pathExists(telemetryDir)) {\n    const files = await fsx.readdir(telemetryDir);\n    for (const file of files) {\n      const full = path.join(telemetryDir, file);\n      const stats = await fsx.stat(full);\n      telemetryBundles.push({\n        file: full,\n        generatedAt: stats.mtime.toISOString()\n      });\n    }\n  }\n\n  const gateLatencies = approvals.map((approval) => approval.latencyMs).filter(Boolean) as number[];\n  const pauseResumeSamples = session.metadata?.pauseResumeMs as number[] | undefined;\n\n  const sla = summarizeSla({\n    sessionId,\n    gateLatencySamples: gateLatencies,\n    pauseResumeSamples\n  });\n\n  const replayPlan = await repository.list(sessionId);\n\n  const report: LiveSessionReport = {\n    session,\n    approvals,\n    telemetryBundles,\n    sla,\n    replayPlan\n  };\n\n  if (options.writeToFile) {\n    await fsx.ensureDir(reportsDir);\n    const file = path.join(reportsDir, `${sessionId}.json`);\n    await fsx.writeJson(file, report, { spaces: 2 });\n  }\n\n  return report;\n}\nEOF\n"]}
[2m2025-10-13T13:13:44.281382Z[0m [32m INFO[0m ToolCall: shell {"command":["bash","-lc","cat <<'EOF' > src/cli/report-live-session.ts\n#!/usr/bin/env tsx\nimport { Command } from \"commander\";\nimport path from \"node:path\";\nimport fsx from \"fs-extra\";\nimport { generateLiveSessionReport } from \"../live/report-generator\";\n\nconst program = new Command();\n\nprogram\n  .argument(\"<sessionId>\", \"Live session identifier\")\n  .option(\"--base-dir <path>\", \"Base directory for live sessions\", \"var/live-sessions\")\n  .option(\"--reports-dir <path>\", \"Output directory for reports\", \"reports/live-sessions\")\n  .option(\"--json\", \"Print report JSON to stdout\", false);\n\nprogram.parse(process.argv);\n\nconst [sessionId] = program.args;\nconst options = program.opts<{ baseDir: string; reportsDir: string; json: boolean }>();\n\nasync function main() {\n  const report = await generateLiveSessionReport(sessionId, {\n    baseDir: options.baseDir,\n    reportsDir: options.reportsDir,\n    writeToFile: true\n  });\n\n  if (options.json) {\n    console.log(JSON.stringify(report, null, 2));\n  } else {\n    console.log(\n      `Report written to ${path.join(path.resolve(options.reportsDir), `${sessionId}.json`)}`\n    );\n  }\n}\n\nmain().catch((error) => {\n  console.error(error instanceof Error ? error.message : String(error));\n  process.exit(1);\n});\nEOF\n"]}
