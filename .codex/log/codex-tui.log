*** Add File: src/state-store/checkpoint-repository.ts
+import { StateStore } from "./index";
+
+const store = StateStore.getInstance();
+
+export type CheckpointRecord = {
+  checkpointId: string;
+  sessionId: string;
+  stepId: string;
+  approvedScopes: string[];
+  domSnapshot?: string;
+  inputBuffer?: Record<string, unknown>;
+  explainabilitySnapshot: Record<string, unknown>;
+  resumeToken: string;
+  resumable: boolean;
+  createdAt?: string;
+};
+
+export const saveCheckpoint = (record: CheckpointRecord): void => {
+  const db = (store as unknown as { db: any }).db;
+  if (!db) {
+    store.init();
+  }
+  db.prepare(
+    `INSERT INTO checkpoints (
+      checkpoint_id, session_id, step_id, approved_scopes, dom_snapshot,
+      input_buffer, explainability_snapshot, resume_token, resumable, created_at
+    ) VALUES (
+      @checkpointId, @sessionId, @stepId, json(@approvedScopes), @domSnapshot,
+      json(@inputBuffer), json(@explainabilitySnapshot), @resumeToken, @resumable,
+      @createdAt
+    )`
+  ).run({
+    ...record,
+    approvedScopes: record.approvedScopes,
+    inputBuffer: record.inputBuffer ?? {},
+    domSnapshot: record.domSnapshot ?? null,
+    createdAt: record.createdAt ?? new Date().toISOString(),
+    resumable: record.resumable ? 1 : 0
+  });
+};
+
+export const latestCheckpoint = (sessionId: string) => {
+  const db = (store as unknown as { db: any }).db;
+  const row = db
+    .prepare(
+      `SELECT *
+       FROM checkpoints
+       WHERE session_id = ?
+       ORDER BY created_at DESC
+       LIMIT 1`
+    )
+    .get(sessionId);
+  if (!row) return undefined;
+  return {
+    checkpointId: row.checkpoint_id,
+    sessionId: row.session_id,
+    stepId: row.step_id,
+    approvedScopes: JSON.parse(row.approved_scopes ?? "[]"),
+    domSnapshot: row.dom_snapshot ?? undefined,
+    inputBuffer: JSON.parse(row.input_buffer ?? "{}"),
+    explainabilitySnapshot: JSON.parse(row.explainability_snapshot ?? "{}"),
+    resumeToken: row.resume_token,
+    resumable: row.resumable === 1,
+    createdAt: row.created_at
+  } as CheckpointRecord;
+};
