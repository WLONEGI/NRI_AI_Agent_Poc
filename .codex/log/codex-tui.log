+import { StateStore } from "./index";
+import type {
+  LiveSessionPersistence,
+  LiveSessionRecord
+} from "../live/types";
+
+export class LiveSessionRepository implements LiveSessionPersistence {
+  private readonly store: StateStore;
+
+  constructor(store = StateStore.getInstance()) {
+    this.store = store;
+  }
+
+  public async insert(session: LiveSessionRecord): Promise<void> {
+    this.store.upsertLiveSession(session);
+  }
+
+  public async update(session: LiveSessionRecord): Promise<void> {
+    this.store.upsertLiveSession(session);
+  }
+
+  public find(sessionId: string): LiveSessionRecord | undefined {
+    return this.store.getLiveSession(sessionId);
+  }
+}
