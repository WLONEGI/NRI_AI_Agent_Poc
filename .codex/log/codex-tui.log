tId\n          in: path\n          required: true\n          schema:\n            type: string\n            description: ULID of the runtime approval request\n      responses:\n        '200':\n          description: Runtime approval request details\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/RuntimeApprovalPayload'\n        '404':\n          description: Request not found or already resolved\n  /gate/runtime-approvals/{requestId}/decision:\n    post:\n      summary: Submit runtime approval decision\n      operationId: submitRuntimeDecision\n      parameters:\n        - name: requestId\n          in: path\n          required: true\n          schema:\n            type: string\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              $ref: '#/components/schemas/ApprovalDecision'\n      responses:\n        '204':\n          description: Decision accepted and orchestrator notified\n        '409':\n          description: Decision already recorded or request expired\n  /telemetry/sessions/{sessionId}:\n    get:\n      summary: Retrieve session telemetry & explainability summary\n      operationId: getTelemetrySession\n      parameters:\n        - name: sessionId\n          in: path\n          required: true\n          schema:\n            type: string\n      responses:\n        '200':\n          description: Aggregated telemetry for auditing and SLA checks\n          content:\n            application/json:\n              schema:\n                $ref: '#/components/schemas/TelemetrySession'\n        '404':\n          description: Session not found\ncomponents:\n  schemas:\n    PlanSummary:\n      type: object\n      required: [planId, sessionId, summary, steps, capabilities, policy, explainability]\n      properties:\n        planId:\n          type: string\n        sessionId:\n          type: string\n        summary:\n          type: string\n          description: High-level description for Gate UI headline\n        steps:\n          type: array\n          items:\n            $ref: '#/components/schemas/PlanStep'\n        capabilities:\n          type: object\n          additionalProperties:\n            type: array\n            items:\n              type: string\n        policy:\n          type: object\n          properties:\n            requires:\n              type: array\n              items:\n                type: string\n        explainability:\n          type: array\n          items:\n            $ref: '#/components/schemas/ExplainabilityDigest'\n        externalTargets:\n          type: array\n          items:\n            type: string\n            description: Domains or URLs that require special scrutiny\n    PlanStep:\n      type: object\n      required: [stepId, orderIndex, action, target, requiresRuntimeApproval]\n      properties:\n        stepId:\n          type: string\n        orderIndex:\n          type: integer\n          minimum: 0\n        action:\n          type: string\n          enum: [navigate, fill, click, upload_file, download, evaluate, snapshot]\n        target:\n          type: object\n          properties:\n            selector:\n              type: string\n            url:\n              type: string\n            description:\n              type: string\n        requiresRuntimeApproval:\n          type: boolean\n        explainability:\n          $ref: '#/components/schemas/ExplainabilityDigest'\n    ExplainabilityDigest:\n      type: object\n      required: [what, why, howSafe, evidence]\n      properties:\n        what:\n          type: string\n        why:\n          type: object\n          required: [goalAlignment, routerDecision]\n          properties:\n            goalAlignment:\n              type: string\n            routerDecision:\n              type: string\n        howSafe:\n          type: object\n          required: [policyVerdict]\n          properties:\n            policyVerdict:\n              type: string\n              enum: [allow, requires_approval, deny]\n            approvalReason:\n              type: string\n        evidence:\n          type: array\n          items:\n            type: string\n    ApprovalDecision:\n      type: object\n      required: [decision]\n      properties:\n        decision:\n          type: string\n          enum: [approve, reject]\n        reason:\n          type: string\n          description: Optional human-entered rationale (masked for PII)\n        latencyMs:\n          type: integer\n          description: UI-measured latency for SLA tracking\n    RuntimeApprovalPayload:\n      type: object\n      required: [requestId, planId, trigger, action, target, explainability]\n      properties:\n        requestId:\n          type: string\n        planId:\n          type: string\n        trigger:\n          type: string\n          enum: [external_submit, upload, download, external_domain, bulk_input, dangerous_eval]\n        action:\n          type: string\n        target:\n          type: object\n          properties:\n            selector:\n              type: string\n            url:\n              type: string\n            fileName:\n              type: string\n        explainability:\n          $ref: '#/components/schemas/ExplainabilityDigest'\n        pendingSince:\n          type: string\n          format: date-time\n    TelemetrySession:\n      type: object\n      required: [sessionId, planId, metrics, spans]\n      properties:\n        sessionId:\n          type: string\n        planId:\n          type: string\n        metrics:\n          type: object\n          properties:\n            gateModalP95Ms:\n              type: integer\n            stopResumeP95Ms:\n              type: integer\n            explainabilityFlushP95Ms:\n              type: integer\n            runtimeApprovalsCount:\n              type: integer\n        spans:\n          type: array\n        