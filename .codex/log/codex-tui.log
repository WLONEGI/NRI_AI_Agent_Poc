[2m2025-10-13T13:08:18.524146Z[0m [32m INFO[0m ToolCall: shell {"command":["bash","-lc","cat <<'EOF' > tests/live/runtime/approve.spec.ts\nimport { test, expect } from \"@playwright/test\";\nimport { liveRuntimeGate } from \"../../..//src/compliance/live-runtime-gate\";\nimport { liveApprovalChannel } from \"../../../src/gate-ui/services/live-approval-channel\";\nimport { ApprovalTimeoutWatchdog } from \"../../../src/live/approval-timeout\";\nimport { LiveApprovalRepository } from \"../../../src/state-store/live-approval-repository\";\nimport { liveSessionManager } from \"../../../src/live/session-manager\";\n\nconst watchdog = new ApprovalTimeoutWatchdog(new LiveApprovalRepository());\n\ntest.describe(\"Runtime approval flow\", () => {\n  test(\"approve path resumes MCP\", async () => {\n    const session = await liveSessionManager.start({\n      planId: \"plan-approve\",\n      approverIds: [\"approver\"],\n      domains: [\"mcp.local\"]\n    });\n\n    const explainability = {\n      what: \"Open external page\",\n      why: { goalAlignment: \"QA requested manual check\" },\n      howSafe: { policyVerdict: \"requires human review\" }\n    } as const;\n\n    const request = await liveRuntimeGate.maybeQueueApproval({\n      sessionId: session.sessionId,\n      planId: session.planId,\n      step: { action: \"navigate\", target: { url: \"https://example.com\" } },\n      explainability\n    });\n\n    expect(request).toBeTruthy();\n    if (!request) throw new Error(\"request expected\");\n\n    watchdog.watch({\n      requestId: request.requestId,\n      sessionId: request.sessionId!,\n      planId: request.planId,\n      trigger: request.trigger,\n      timeoutMs: 5_000\n    });\n\n    const decisionPromise = liveApprovalChannel.waitForDecision(request.requestId);\n\n    const start = Date.now();\n    setTimeout(() => {\n      liveApprovalChannel.notifyDecision({\n        requestId: request.requestId,\n        approved: true,\n        decidedBy: \"approver\",\n        decidedAt: new Date().toISOString(),\n        latencyMs: Date.now() - start\n      });\n      watchdog.clear(request.requestId);\n    }, 50);\n\n    const decision = await decisionPromise;\n    expect(decision.approved).toBe(true);\n    expect(decision.latencyMs).toBeLessThanOrEqual(200);\n  });\n});\nEOF\n"],"timeout_ms":120000,"workdir":"."}
