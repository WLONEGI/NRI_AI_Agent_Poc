+#!/usr/bin/env node
+import { randomBytes } from "node:crypto";
+import { writeFileSync } from "node:fs";
+import { resolve } from "node:path";
+
+const key = randomBytes(32).toString("base64");
+const file = process.argv.includes("--output")
+  ? resolve(process.cwd(), process.argv[process.argv.indexOf("--output") + 1])
+  : resolve(process.cwd(), ".env.local");
+
+writeFileSync(file, `SAFE_STORAGE_KEY=${key}\n`, { encoding: "utf8" });
+console.log(`Generated SAFE_STORAGE_KEY and wrote to ${file}`);
