+import fetch, { Response } from "node-fetch";
+
+export type LiveNotificationType =
+  | "session-start"
+  | "session-complete"
+  | "session-failed"
+  | "sla-breach"
+  | "timeout"
+  | "checkpoint"
+  | "manual-intervention";
+
+export interface LiveNotificationPayload {
+  type: LiveNotificationType;
+  sessionId: string;
+  title: string;
+  message: string;
+  severity?: "info" | "warning" | "critical";
+  fields?: Record<string, string | number | boolean>;
+  metadata?: Record<string, unknown>;
+}
+
+export interface LiveNotifierOptions {
+  webhookUrl: string;
+  maxRetries?: number;
+  baseDelayMs?: number;
+  timeoutMs?: number;
+}
+
+export class LiveNotifier {
+  private readonly webhookUrl: string;
+  private readonly maxRetries: number;
+  private readonly baseDelayMs: number;
+  private readonly timeoutMs: number;
+
+  constructor(options: LiveNotifierOptions) {
+    this.webhookUrl = options.webhookUrl;
+    this.maxRetries = options.maxRetries ?? 3;
+    this.baseDelayMs = options.baseDelayMs ?? 500;
+    this.timeoutMs = options.timeoutMs ?? 10_000;
+  }
+
+  public async notify(payload: LiveNotificationPayload): Promise<void> {
+    const body = this.buildSlackPayload(payload);
+    await this.postWithRetry(body);
+  }
+
+  private buildSlackPayload(payload: LiveNotificationPayload) {
+    const color = this.resolveColor(payload.severity);
+    const fields =
+      payload.fields &&
+      Object.entries(payload.fields).map(([title, value]) => ({
+        type: "mrkdwn",
+        text: `*${title}*\n${value}`
+      }));
+
+    return {
+      attachments: [
+        {
+          color,
+          title: payload.title,
+          text: payload.message,
+          footer: `session: ${payload.sessionId} • event: ${payload.type}`,
+          ts: Math.floor(Date.now() / 1000),
+          fields
+        }
+      ]
+    };
+  }
+
+  private resolveColor(severity: LiveNotificationPayload["severity"]) {
+    switch (severity) {
+      case "critical":
+        return "#d92d20";
+      case "warning":
+        return "#f79009";
+      default:
+        return "#0f70d7";
+    }
+  }
+
+  private async postWithRetry(body: unknown): Promise<void> {
+    let attempt = 0;
+    let lastError: Error | undefined;
+
+    while (attempt <= this.maxRetries) {
+      try {
+        const response = await this.send(body);
+        if (!response.ok) {
+          throw new Error(`Slack webhook responded with ${response.status}`);
+        }
+        return;
+      } catch (error) {
+        lastError = error instanceof Error ? error : new Error(String(error));
+        attempt += 1;
+        if (attempt > this.maxRetries) {
+          break;
+        }
+        await this.sleep(this.baseDelayMs * Math.pow(2, attempt - 1));
+      }
+    }
+
+    throw lastError ?? new Error("Unknown Slack notifier error");
+  }
+
+  private async send(body: unknown): Promise<Response> {
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), this.timeoutMs);
+
+    try {
+      return await fetch(this.webhookUrl, {
+        method: "POST",
+        headers: {
+          "Content-Type": "application/json"
+        },
+        body: JSON.stringify(body),
+        signal: controller.signal
+      });
+    } finally {
+      clearTimeout(timeout);
+    }
+  }
+
+  private async sleep(ms: number): Promise<void> {
+    await new Promise((resolve) => setTimeout(resolve, ms));
+  }
+}
