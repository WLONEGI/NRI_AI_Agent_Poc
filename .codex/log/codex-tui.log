+import Database from "better-sqlite3";
+import { readFileSync, mkdirSync, existsSync } from "node:fs";
+import { resolve, dirname } from "node:path";
+
+export type PlanDocumentRecord = {
+  planId: string;
+  sessionId: string;
+  createdAt: string;
+  author: string;
+  status: string;
+  summary: string;
+  steps: unknown;
+  capabilities: unknown;
+  policy: unknown;
+  explainabilityDigest: unknown;
+  approvals?: unknown;
+};
+
+export type ApprovalDecisionRecord = {
+  requestId: string;
+  planId: string;
+  type: "pre" | "runtime";
+  trigger?: string | null;
+  payload: unknown;
+  status: "pending" | "approved" | "rejected" | "superseded";
+  decidedAt?: string | null;
+  decidedBy?: string | null;
+  rationale?: string | null;
+};
+
+export class StateStore {
+  private static instance: StateStore;
+  private db!: Database.Database;
+  private auditLogPath: string = resolve(process.cwd(), "approval.audit.jsonl");
+
+  private constructor() {}
+
+  public static getInstance(): StateStore {
+    if (!StateStore.instance) {
+      StateStore.instance = new StateStore();
+    }
+    return StateStore.instance;
+  }
+
+  public init(dbFile = resolve(process.cwd(), "var/state-store/state.db")): void {
+    const dir = dirname(dbFile);
+    if (!existsSync(dir)) {
+      mkdirSync(dir, { recursive: true });
+    }
+    this.db = new Database(dbFile);
+    this.db.pragma("journal_mode = WAL");
+    this.applyMigrations();
+  }
+
+  public savePlanDocument(record: PlanDocumentRecord): void {
+    const stmt = this.db.prepare(
+      `INSERT INTO plan_documents(
+        plan_id, session_id, created_at, author, status, summary,
+        steps, capabilities, policy, explainability_digest, approvals
+      ) VALUES (
+        @planId, @sessionId, @createdAt, @author, @status, @summary,
+        json(@steps), json(@capabilities), json(@policy), json(@explainabilityDigest), json(@approvals)
+      )
+      ON CONFLICT(plan_id) DO UPDATE SET
+        status = excluded.status,
+        summary = excluded.summary,
+        steps = excluded.steps,
+        approvals = excluded.approvals`
+    );
+    stmt.run(record);
+  }
+
+  public saveApprovalDecision(decision: ApprovalDecisionRecord): void {
+    const stmt = this.db.prepare(
+      `INSERT INTO approval_requests(
+        request_id, plan_id, type, trigger, payload, status,
+        decided_at, decided_by, rationale
+      ) VALUES(
+        @requestId, @planId, @type, @trigger, json(@payload), @status,
+        @decidedAt, @decidedBy, @rationale
+      )
+      ON CONFLICT(request_id) DO UPDATE SET
+        status = excluded.status,
+        decided_at = excluded.decided_at,
+        decided_by = excluded.decided_by,
+        rationale = excluded.rationale`
+    );
+    stmt.run(decision);
+    this.appendAuditLog(decision);
+  }
+
+  public getPlan(planId: string): PlanDocumentRecord | undefined {
+    const stmt = this.db.prepare(
+      `SELECT
+        plan_id as planId,
+        session_id as sessionId,
+        created_at as createdAt,
+        author,
+        status,
+        summary,
+        json(step
+s) as steps,
+        json(capabilities) as capabilities,
+        json(policy) as policy,
+        json(explainability_digest) as explainabilityDigest,
+        json(approvals) as approvals
+      FROM plan_documents
+      WHERE plan_id = ?`
+    );
+    return stmt.get(planId);
+  }
+
+  private appendAuditLog(decision: ApprovalDecisionRecord): void {
+    const line = JSON.stringify({
+      ...decision,
+      payload: decision.payload ?? {},
+      timestamp: decision.decidedAt ?? new Date().toISOString()
+    });
+    const fd = Database.open(this.auditLogPath, { readonly: false });
+    try {
+      Database.write(this.auditLogPath, `${line}\n`, { flag: "a" });
+    } finally {
+      fd.close();
+    }
+  }
+
+  private applyMigrations(): void {
+    const migrationPath = resolve(
+      process.cwd(),
+      "src/state-store/migrations/0001_init.sql"
+    );
+    const sql = readFileSync(migrationPath, "utf8");
+    this.db.exec(sql);
+  }
+}
