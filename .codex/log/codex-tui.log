+import crypto from "node:crypto";
+import path from "node:path";
+import fsx from "fs-extra";
+
+export interface TelemetryBundleInput {
+  sessionId: string;
+  stepId: string;
+  spans: unknown[];
+  explainability: unknown;
+  screenshot?: Buffer;
+  screenshotType?: "png" | "jpg";
+  browserLogs?: string[];
+  networkLogs?: string[];
+}
+
+export interface TelemetryBundleRecord {
+  bundleId: string;
+  sessionId: string;
+  stepId: string;
+  spanFile: string;
+  explainabilityFile: string;
+  screenshotPath?: string;
+  browserLogPath?: string;
+  generatedAt: string;
+}
+
+export interface TelemetryBundleWriterOptions {
+  baseDir?: string;
+}
+
+export class TelemetryBundleWriter {
+  private readonly baseDir: string;
+
+  constructor(options?: TelemetryBundleWriterOptions) {
+    this.baseDir = path.resolve(options?.baseDir ?? "var/live-sessions");
+  }
+
+  public async write(input: TelemetryBundleInput): Promise<TelemetryBundleRecord> {
+    const bundleId = `bundle-${crypto.randomUUID()}`;
+    const generatedAt = new Date().toISOString();
+
+    const telemetryDir = path.join(this.baseDir, "telemetry", input.sessionId);
+    const explainDir = path.join(this.baseDir, "explainability", input.sessionId);
+    const screenshotDir = path.join(this.baseDir, "screenshots", input.sessionId);
+    const logDir = path.join(this.baseDir, "network", input.sessionId);
+
+    await Promise.all([
+      fsx.ensureDir(telemetryDir),
+      fsx.ensureDir(explainDir),
+      fsx.ensureDir(screenshotDir),
+      fsx.ensureDir(logDir)
+    ]);
+
+    const spanFile = path.join(telemetryDir, `${bundleId}.json`);
+    const explainabilityFile = path.join(explainDir, `${bundleId}.json`);
+
+    await Promise.all([
+      fsx.writeJson(spanFile, { generatedAt, spans: input.spans }, { spaces: 2 }),
+      fsx.writeJson(
+        explainabilityFile,
+        { generatedAt, explainability: input.explainability },
+        { spaces: 2 }
+      )
+    ]);
+
+    let screenshotPath: string | undefined;
+    if (input.screenshot && input.screenshot.length > 0) {
+      const extension = input.screenshotType === "jpg" ? "jpg" : "png";
+      screenshotPath = path.join(screenshotDir, `${bundleId}.${extension}`);
+      await fsx.writeFile(screenshotPath, input.screenshot);
+    }
+
+    let browserLogPath: string | undefined;
+    if (input.browserLogs?.length) {
+      browserLogPath = path.join(logDir, `${bundleId}.log`);
+      await fsx.writeFile(browserLogPath, input.browserLogs.join("\n"), { encoding: "utf8" });
+    }
+
+    if (input.networkLogs?.length) {
+      const networkFile = path.join(logDir, `${bundleId}.network.log`);
+      await fsx.writeFile(networkFile, input.networkLogs.join("\n"), { encoding: "utf8" });
+    }
+
+    return {
+      bundleId,
+      sessionId: input.sessionId,
+      stepId: input.stepId,
+      spanFile,
+      explainabilityFile,
+      screenshotPath,
+      browserLogPath,
+      generatedAt
+    };
+  }
+}
